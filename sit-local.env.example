# SIT local Docker run — template. Copy to `.env` (gitignored) and fill in. Never commit real values.
#   cp sit-local.env.example .env
# See "SIT local Docker run" in README.md. Generate secrets with `openssl rand -hex 32` unless noted.

DB_PASSWORD=change-me
DB_NAME=lmsdb
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=http://localhost:3003
JWT_SECRET=
SCHEDULER_SECRET=
DIRECT_APPLICATION_EMAIL_INGEST_TOKEN=
EXTERNAL_API_KEY_FOR_CLAWDBOT=

# First admin (also reused as the Open WebUI admin). The login form is <input type="email">, so the id must look like an email.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Local Admin
COMPANY_NAME=SIT
TRAINING_PARTNER_UEN=000000000A

# Calendar writes stay off until a dedicated TEST calendar id is set (the sync falls back to 'primary' otherwise).
ENABLE_CALENDAR_WRITES=false

# Local mock SSG/TPGateway server (compose service ssg-mock).
# CERT_1_CERT / CERT_1_KEY: base64 of a throwaway PEM cert / key (e.g. `openssl req -x509 -newkey rsa:2048 -nodes -keyout k.pem -out c.pem -subj /CN=local`, then `base64 < c.pem | tr -d '\n'`).
# CERT_1_ENCRYPTION_KEY: base64 of 32 random bytes -> `openssl rand -base64 32`.
SSG_API_URL=http://ssg-mock:4010
SSG_API_BASE_URL=http://ssg-mock:4010
CERT_1_NAME=App1
CERT_1_CERT=
CERT_1_KEY=
CERT_1_ENCRYPTION_KEY=

# Claude via an OpenAI/Anthropic-compatible gateway, through the local model-name shim (compose service anthropic-shim).
# The shim returns 503 until GATEWAY_URL and GATEWAY_KEY are set. ANTHROPIC_API_KEY is only a placeholder so the app treats Claude as connected.
GATEWAY_URL=
GATEWAY_KEY=
ANTHROPIC_BASE_URL=http://anthropic-shim:4020
ANTHROPIC_API_KEY=sk-ant-api03-local-shim-placeholder

# Open WebUI chat launcher (compose service open-webui)
WEBUI_SECRET_KEY=

# Google Calendar (local/google-oauth/setup-calendar.js): from a Google "Desktop app" OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
